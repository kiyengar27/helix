{
  "name": "helix-provisioning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/provision-care-delivery.ts --preview",
    "apply": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --apply",
    "plan": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --plan",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && npm test",
    "verify": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --verify",
    "preview:care-delivery": "tsx scripts/preview-care-delivery.ts",
    "policy": "tsx scripts/provision-care-delivery.ts --policy",
    "validate:server": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --validate-only"
  },
  "dependencies": {
    "@medplum/core": "^5.2.5",
    "@medplum/fhirtypes": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2.0 <25"
  }
}
