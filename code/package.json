{
  "name": "helix-provisioning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "preview": "tsx scripts/provision-care-delivery.ts --preview",
    "apply": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --apply",
    "plan": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --plan",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && npm test",
    "verify": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --verify",
    "preview:care-delivery": "tsx scripts/preview-care-delivery.ts",
    "policy": "tsx scripts/provision-care-delivery.ts --policy",
    "validate:server": "node --env-file-if-exists=.env --import tsx scripts/provision-care-delivery.ts --validate-only",
    "preview:enrollment": "tsx scripts/preview-enrollment.ts",
    "prepare:enrollment": "node --env-file-if-exists=.env --import tsx scripts/prepare-enrollment.ts",
    "plan:enrollment": "node --env-file-if-exists=.env --import tsx scripts/provision-enrollment.ts --plan",
    "apply:enrollment": "node --env-file-if-exists=.env --import tsx scripts/provision-enrollment.ts --apply",
    "verify:enrollment": "node --env-file-if-exists=.env --import tsx scripts/provision-enrollment.ts --verify",
    "prepare:enrollment-access": "node --env-file-if-exists=.env --import tsx scripts/prepare-enrollment-access.ts",
    "acceptance:enrollment": "node --env-file-if-exists=.env --import tsx scripts/acceptance-enrollment.ts",
    "preview:encounters": "tsx scripts/preview-encounters.ts",
    "validate:encounters": "node --env-file-if-exists=.env --import tsx scripts/validate-encounters.ts",
    "prepare:encounter-deployment": "node --env-file-if-exists=.env --import tsx scripts/prepare-encounter-deployment.ts",
    "plan:encounters": "node --env-file-if-exists=.env --import tsx scripts/provision-encounters.ts --plan",
    "apply:encounters": "node --env-file-if-exists=.env --import tsx scripts/provision-encounters.ts --apply",
    "verify:encounters": "node --env-file-if-exists=.env --import tsx scripts/provision-encounters.ts --verify",
    "flow-plan:encounters": "node --env-file-if-exists=.env --import tsx scripts/provision-encounters.ts --flow-plan",
    "flow-apply:encounters": "node --env-file-if-exists=.env --import tsx scripts/provision-encounters.ts --flow-apply",
    "verify:encounter-access": "node --env-file-if-exists=.env --import tsx scripts/verify-encounter-access.ts",
    "plan:photon-patient": "node --env-file-if-exists=.env --import tsx scripts/photon-patient-sync.ts --plan",
    "apply:photon-patient": "node --env-file-if-exists=.env --import tsx scripts/photon-patient-sync.ts --apply",
    "verify:photon-patient": "node --env-file-if-exists=.env --import tsx scripts/photon-patient-sync.ts --verify"
  },
  "dependencies": {
    "@medplum/core": "^5.2.5",
    "@medplum/fhirtypes": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.2.0 <25"
  }
}
