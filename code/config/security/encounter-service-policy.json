{
  "resourceType": "AccessPolicy",
  "name": "Helix Staging Encounter Service",
  "resource": [
    {
      "resourceType": "Encounter",
      "interaction": [
        "read",
        "search",
        "create",
        "update",
        "history",
        "vread"
      ],
      "criteria": "Encounter?identifier=urn:helix:staging:encounter-intent|adult-glp1-encounter,urn:helix:staging:encounter-intent|caregiver-infection-encounter",
      "writeConstraint": [
        {
          "language": "text/fhirpath",
          "expression": "%before.exists().not() implies status = 'planned'"
        },
        {
          "language": "text/fhirpath",
          "expression": "%before.exists() implies (status = %before.status or (%before.status = 'planned' and (status = 'in-progress' or status = 'cancelled')) or (%before.status = 'in-progress' and (status = 'finished' or status = 'cancelled')))"
        },
        {
          "language": "text/fhirpath",
          "expression": "%before.exists() implies subject.reference = %before.subject.reference"
        }
      ]
    },
    {
      "resourceType": "MedicationRequest",
      "interaction": [
        "read",
        "search",
        "create"
      ],
      "criteria": "MedicationRequest?identifier=urn:helix:staging:encounter-intent|adult-glp1-medication-request,urn:helix:staging:encounter-intent|caregiver-infection-medication-request",
      "writeConstraint": [
        {
          "language": "text/fhirpath",
          "expression": "status = 'draft' and intent = 'proposal'"
        }
      ]
    },
    {
      "resourceType": "Task",
